From 0000000000000000000000000000000000000001 Mon Sep 17 00:00:00 2001
From: Sparrow Hawk BSP <bsp@sparrow-hawk>
Date: Wed, 01 Jan 2025 00:00:00 +0000
Subject: [PATCH 1/3] drivers/spi: add R-Car RPC-IF SPI bus driver

Add a minimal generic SPI bus abstraction (struct spi_chip / spi_xfer)
and a driver for the Renesas R-Car RPC-IF controller in Manual SPI Mode.

Enabled by CFG_RCAR_RPCIF_SPI=y. Default MMIO base: 0xEE200000.

Signed-off-by: Sparrow Hawk BSP <bsp@sparrow-hawk>
---
 core/arch/arm/plat-rcar/conf.mk       |  10 +++
 core/drivers/sub.mk                   |   1 +
 core/drivers/spi/rcar_rpcif.c         | 405 ++++++++++++++++++++++++++++++++++
 core/drivers/spi/sub.mk               |   3 +
 core/include/drivers/rcar_rpcif.h     |  60 ++++++++
 core/include/drivers/spi.h            |  43 +++++++++++
 6 files changed, 522 insertions(+)
 create mode 100644 core/drivers/spi/rcar_rpcif.c
 create mode 100644 core/drivers/spi/sub.mk
 create mode 100644 core/include/drivers/rcar_rpcif.h
 create mode 100644 core/include/drivers/spi.h

diff --git a/core/arch/arm/plat-rcar/conf.mk b/core/arch/arm/plat-rcar/conf.mk
index aaaaaa1..aaaaaa2 100644
--- a/core/arch/arm/plat-rcar/conf.mk
+++ b/core/arch/arm/plat-rcar/conf.mk
@@ -44,3 +44,12 @@
 $(call force,CFG_ARM_GICV3, y)
 endif
 
+
+# RPC-IF SPI driver (Manual SPI Mode, e.g. Winbond W77Q on R-Car Gen4).
+# Set CFG_RCAR_RPCIF_SPI=y to enable.
+# CFG_RPCIF_BASE may be overridden for boards with a non-default base address.
+ifeq ($(CFG_RCAR_RPCIF_SPI),y)
+$(call force,CFG_DRIVERS_SPI,y)
+CFG_RPCIF_BASE ?= 0xEE200000
+CFG_RPCIF_FLASH_BASE ?= 0x08000000
+endif
