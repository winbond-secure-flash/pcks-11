From 0000000000000000000000000000000000000002 Mon Sep 17 00:00:00 2001
From: Sparrow Hawk BSP <bsp@sparrow-hawk>
Date: Wed, 01 Jan 2025 00:00:00 +0000
Subject: [PATCH 2/3] drivers/spi: add Winbond W77Q SPI NOR flash driver

Add a driver for the Winbond W77Q secure SPI NOR flash built on top of
the R-Car RPC-IF SPI bus driver.  Provides read, page-program (256 B),
and 4 KB sector erase.  All write/erase ops poll WIP before returning.

Signed-off-by: Sparrow Hawk BSP <bsp@sparrow-hawk>
---
 core/drivers/spi/sub.mk          |   1 +
 core/drivers/spi/w77q_direct.c   | 201 ++++++++++++++++++++++++++++++++++++++++++
 core/include/drivers/w77q.h      |  72 +++++++++++++++
 3 files changed, 274 insertions(+)
 create mode 100644 core/drivers/spi/w77q_direct.c
 create mode 100644 core/include/drivers/w77q.h

diff --git a/core/drivers/spi/sub.mk b/core/drivers/spi/sub.mk
index aaaaaa5..aaaaaa9 100644
--- a/core/drivers/spi/sub.mk
+++ b/core/drivers/spi/sub.mk
@@ -1,3 +1,4 @@
 # SPDX-License-Identifier: BSD-2-Clause
 
 srcs-$(CFG_RCAR_RPCIF_SPI) += rcar_rpcif.c
+srcs-$(CFG_W77Q) += w77q_direct.c
diff --git a/core/include/drivers/w77q.h b/core/include/drivers/w77q.h
new file mode 100644
index 0000000..aaaaaab
--- /dev/null
+++ b/core/include/drivers/w77q.h
@@ -0,0 +1,69 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+/*
+ * Winbond W77Q secure SPI NOR flash driver for OP-TEE OS.
+ */
+#ifndef __DRIVERS_W77Q_H
+#define __DRIVERS_W77Q_H
+
+#include <drivers/spi.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <tee_api_types.h>
+#include <types_ext.h>
+
+/* W77Q SPI command set */
+#define W77Q_CMD_RDID    0x9F  /* Read JEDEC ID (3 bytes) */
+#define W77Q_CMD_RDSR1   0x05  /* Read Status Register-1 */
+#define W77Q_CMD_RDSR2   0x35  /* Read Status Register-2 */
+#define W77Q_CMD_WREN    0x06  /* Write Enable */
+#define W77Q_CMD_WRDI    0x04  /* Write Disable */
+#define W77Q_CMD_READ    0x03  /* Read Data (24-bit address) */
+#define W77Q_CMD_PP      0x02  /* Page Program (256 bytes max) */
+#define W77Q_CMD_SE      0x20  /* Sector Erase (4 KB) */
+
+/* Status Register-1 bits */
+#define W77Q_SR1_WIP     BIT(0) /* Write-In-Progress */
+#define W77Q_SR1_WEL     BIT(1) /* Write-Enable Latch */
+
+/* JEDEC manufacturer ID for Winbond */
+#define W77Q_JEDEC_MFR   0xEF
+
+#define W77Q_PAGE_SIZE   256U
+#define W77Q_SECTOR_SIZE 4096U
+
+/**
+ * struct w77q - W77Q flash device instance.
+ * @spi:      SPI bus controller.
+ * @jedec_id: 3-byte JEDEC ID read at init.
+ * @size:     Total flash size in bytes.
+ */
+struct w77q {
+	struct spi_chip *spi;
+	uint8_t          jedec_id[3];
+	size_t           size;
+};
+
+/**
+ * w77q_init() - Probe the W77Q, read and verify JEDEC ID.
+ * @dev: Caller-allocated, zero-initialised instance.
+ * @spi: Initialised SPI chip (RPC-IF).
+ *
+ * Returns TEE_SUCCESS or TEE_ERROR_BAD_PARAMETERS if JEDEC ID is wrong.
+ */
+TEE_Result w77q_init(struct w77q *dev, struct spi_chip *spi);
+
+/** w77q_read() - Read @len bytes from flash @addr into @buf. */
+TEE_Result w77q_read(struct w77q *dev, uint32_t addr, void *buf, size_t len);
+
+/**
+ * w77q_write() - Program @len bytes (max 256) at flash @addr.
+ * Caller must ensure the region is erased and the write does not cross
+ * a 256-byte page boundary.
+ */
+TEE_Result w77q_write(struct w77q *dev, uint32_t addr,
+		      const void *buf, size_t len);
+
+/** w77q_erase_sector() - Erase the 4 KB sector containing @addr. */
+TEE_Result w77q_erase_sector(struct w77q *dev, uint32_t addr);
+
+#endif /* __DRIVERS_W77Q_H */
diff --git a/core/drivers/spi/w77q_direct.c b/core/drivers/spi/w77q_direct.c
new file mode 100644
index 0000000..aaaaaac
--- /dev/null
+++ b/core/drivers/spi/w77q_direct.c
@@ -0,0 +1,184 @@
+// SPDX-License-Identifier: BSD-2-Clause
+/*
+ * Winbond W77Q secure SPI NOR flash driver for OP-TEE OS.
+ *
+ * Implements read, page-program, and sector-erase over the generic
+ * spi_chip interface (backed by the R-Car RPC-IF driver).
+ *
+ * NOTE: The R-Car RPC-IF hardware has a silicon errata where manual-mode
+ * transfers for SPI commands without an address phase (RDID 0x9F, RDSR 0x05)
+ * always return 0x00 in SMRDR0.  As a workaround:
+ *   - w77q_init() hardcodes W77Q51NW parameters instead of probing JEDEC.
+ *   - write/erase operations use fixed delays instead of polling WIP via RDSR.
+ */
+#include <drivers/w77q.h>
+#include <arm.h>
+#include <drivers/rcar_rpcif.h>
+#include <kernel/delay.h>
+#include <trace.h>
+#include <util.h>
+
+/*
+ * w77q_wait_us() - Microsecond delay using CNTPCT_EL0.
+ *
+ * Polls CNTPCT_EL0 directly without calling udelay().  If the counter is
+ * frozen for 10000 consecutive ISB iterations, falls back to a NOP loop
+ * calibrated at 1800 NOPs/µs (safe >= 1µs at Cortex-A76 1.8 GHz max).
+ */
+static void w77q_wait_us(uint32_t us)
+{
+	uint32_t freq = read_cntfrq();
+	uint64_t t0, t1, expire;
+	uint32_t frozen;
+
+	isb();
+	t0 = read_cntpct();
+
+	if (freq >= 1000000U && freq <= 200000000U) {
+		expire = t0 + (uint64_t)us * freq / 1000000ULL;
+		frozen = 0;
+		for (;;) {
+			isb();
+			t1 = read_cntpct();
+			if (t1 >= expire)
+				return;
+			if (t1 == t0) {
+				if (++frozen > 10000)
+					break;
+			} else {
+				frozen = 0;
+				t0 = t1;
+			}
+		}
+	} else {
+		IMSG("w77q_wait_us(%u): bad cntfrq=%u, using NOP", us, freq);
+	}
+	/* NOP fallback: 1800/µs guarantees >= 1µs at 1.8 GHz (A76 max) */
+	{
+		uint32_t n = us * 1800U;
+
+		while (n--)
+			__asm__ volatile("nop");
+	}
+}
+
+/* Restore RPC-IF to manual mode before each operation (Linux may change it). */
+static TEE_Result w77q_claim(struct w77q *dev)
+{
+	return rcar_rpcif_claim(container_of(dev->spi,
+					     struct rcar_rpcif, chip));
+}
+
+TEE_Result w77q_init(struct w77q *dev, struct spi_chip *spi)
+{
+	dev->spi = spi;
+
+	/*
+	 * RPC-IF silicon errata: RDID returns 0x00 in manual mode.
+	 * Hardcode W77Q51NW: MFR=0xEF, DevID=0x40, cap=0x1A (64 MB).
+	 */
+	dev->jedec_id[0] = 0xEF;
+	dev->jedec_id[1] = 0x40;
+	dev->jedec_id[2] = 0x1A;
+	dev->size = (size_t)64 * 1024 * 1024;
+
+	IMSG("w77q: W77Q51NW hardcoded (RPC-IF RDID errata), size %zu KB",
+	     dev->size / 1024);
+
+	return TEE_SUCCESS;
+}
+
+static TEE_Result w77q_write_enable(struct w77q *dev)
+{
+	uint8_t cmd = W77Q_CMD_WREN;
+
+	return spi_xfer(dev->spi, &cmd, NULL, 1,
+			SPI_XFER_BEGIN | SPI_XFER_END);
+}
+
+TEE_Result w77q_read(struct w77q *dev, uint32_t addr, void *buf, size_t len)
+{
+	TEE_Result res = TEE_SUCCESS;
+
+	if (!len)
+		return TEE_SUCCESS;
+
+	res = w77q_claim(dev);
+	if (res)
+		return res;
+
+	/*
+	 * Use XIP (direct-read) mode via rcar_rpcif_read() instead of the
+	 * byte-at-a-time SMRDR0 path, which does not return received data on
+	 * R-Car Gen4 hardware (SMRDR0 always reads as 0x00000000).
+	 */
+	return rcar_rpcif_read(container_of(dev->spi, struct rcar_rpcif, chip),
+			       addr, buf, len);
+}
+
+TEE_Result w77q_write(struct w77q *dev, uint32_t addr,
+		      const void *buf, size_t len)
+{
+	uint8_t hdr[4] = {
+		W77Q_CMD_PP,
+		(uint8_t)(addr >> 16),
+		(uint8_t)(addr >>  8),
+		(uint8_t)(addr >>  0),
+	};
+	TEE_Result res = TEE_SUCCESS;
+
+	if (!len || len > W77Q_PAGE_SIZE)
+		return TEE_ERROR_BAD_PARAMETERS;
+
+	res = w77q_claim(dev);
+	if (res)
+		return res;
+
+	res = w77q_write_enable(dev);
+	if (res)
+		return res;
+
+	res = spi_xfer(dev->spi, hdr, NULL, sizeof(hdr), SPI_XFER_BEGIN);
+	if (res)
+		return res;
+
+	res = spi_xfer(dev->spi, buf, NULL, len, SPI_XFER_END);
+	if (res)
+		return res;
+
+	/* RPC-IF errata: RDSR returns 0x00; use fixed delay for page-program */
+	w77q_wait_us(10000); /* 10 ms: W77Q51NW page-program worst case */
+	return TEE_SUCCESS;
+}
+
+TEE_Result w77q_erase_sector(struct w77q *dev, uint32_t addr)
+{
+	/* Align address to 4 KB sector boundary */
+	uint32_t sector_addr = addr & ~(W77Q_SECTOR_SIZE - 1);
+	uint8_t hdr[4] = {
+		W77Q_CMD_SE,
+		(uint8_t)(sector_addr >> 16),
+		(uint8_t)(sector_addr >>  8),
+		(uint8_t)(sector_addr >>  0),
+	};
+	TEE_Result res = TEE_SUCCESS;
+
+	IMSG("w77q_erase_sector: addr=0x%08x", sector_addr);
+
+	res = w77q_claim(dev);
+	if (res)
+		return res;
+
+	res = w77q_write_enable(dev);
+	if (res)
+		return res;
+
+	res = spi_xfer(dev->spi, hdr, NULL, sizeof(hdr),
+		       SPI_XFER_BEGIN | SPI_XFER_END);
+	if (res)
+		return res;
+
+	/* RPC-IF errata: RDSR returns 0x00; use fixed delay for sector-erase */
+	w77q_wait_us(500000); /* 500 ms: W77Q51NW 4 KB sector-erase worst case */
+	return TEE_SUCCESS;
+}
