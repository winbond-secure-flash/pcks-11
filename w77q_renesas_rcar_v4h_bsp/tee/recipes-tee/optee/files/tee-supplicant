#!/bin/sh
### BEGIN INIT INFO
# Provides:          tee-supplicant
# Required-Start:    $local_fs
# Required-Stop:     $local_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: TEE Supplicant daemon
# Description:       Starts tee-supplicant with all TA search paths.
#                    /lib/optee_armtz  — layer-local TAs (tee-demo)
#                    /usr/lib/optee_armtz — installed TAs (optee-examples)
### END INIT INFO

DAEMON=/usr/bin/tee-supplicant
OPTS="--ta-path /lib/optee_armtz --ta-path /usr/lib/optee_armtz"
PIDFILE=/var/run/tee-supplicant.pid

case "$1" in
    start)
        echo -n "Starting TEE Supplicant: "
        start-stop-daemon --start --background --make-pidfile \
            --pidfile "$PIDFILE" --exec "$DAEMON" -- $OPTS
        echo "done."
        ;;
    stop)
        echo -n "Stopping TEE Supplicant: "
        start-stop-daemon --stop --pidfile "$PIDFILE"
        rm -f "$PIDFILE"
        echo "done."
        ;;
    restart)
        "$0" stop
        sleep 1
        "$0" start
        ;;
    status)
        if [ -f "$PIDFILE" ] && kill -0 "$(cat $PIDFILE)" 2>/dev/null; then
            echo "tee-supplicant is running (pid $(cat $PIDFILE))"
        else
            echo "tee-supplicant is not running"
            exit 1
        fi
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac

exit 0
